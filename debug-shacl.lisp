(require :asdf)
(asdf:load-system :ariadne)
(in-package :ariadne)
(let ((g (make-graph :name "test")))
  (import-turtle g (with-open-file (s "test-data/shacl/data-shapes/data-shapes-test-suite/tests/core/misc/deactivated-001.ttl")
                     (let ((b (make-string (file-length s)))) (read-sequence b s) b)))
  (dolist (tr (get-triples g :predicate "http://www.w3.org/ns/shacl#deactivated"))
    (format t "deactivated: ~S (type: ~A)~%" (triple-object tr) (type-of (triple-object tr)))))
