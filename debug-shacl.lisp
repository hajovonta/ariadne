(require :asdf)
(asdf:load-system :ariadne)
(in-package :ariadne)
(let ((g (make-graph :name "test")))
  (import-turtle g (with-open-file (s "test-data/shacl/data-shapes/data-shapes-test-suite/tests/core/property/property-001.ttl")
                     (let ((b (make-string (file-length s)))) (read-sequence b s) b)))
  (let ((shape "http://datashapes.org/sh/tests/core/property/property-001.test#PersonShape"))
    (format t "Prop shapes: ~S~%" (shape-property-shapes g shape))
    (dolist (ps (shape-property-shapes g shape))
      (format t "  ps=~S path=~S~%" ps (prop-shape-path g ps))
      (format t "  nested props: ~S~%" (shape-property-shapes g ps)))))
